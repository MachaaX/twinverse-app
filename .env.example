# Copy to .env and fill in existing endpoints/login details. Never commit .env.
# AWS mode requires both S3 and PostgreSQL saves before a patient is published.
TWINVERSE_CLOUD_STORAGE=aws
TWINVERSE_S3_BUCKET=twinverse-s3-bucket-1
TWINVERSE_S3_PREFIX=twinverse
TWINVERSE_S3_EXPECTED_OWNER=454105254021
AWS_REGION=us-west-2
# Use a valid named AWS profile, or omit this to use env/instance-role credentials.
AWS_PROFILE=workshop
# Optional, only when the existing bucket requires this KMS key:
# TWINVERSE_S3_KMS_KEY_ID=arn:aws:kms:us-west-2:ACCOUNT_ID:key/KEY_ID

# An RDS/Aurora PostgreSQL writer hostname, not an https:// console URL.
PGHOST=YOUR_DATABASE_ENDPOINT.rds.amazonaws.com
PGPORT=5432
PGDATABASE=twinverse
PGUSER=twinverse_app
# Password mode, or IAM mode to generate a fresh RDS token per connection.
TWINVERSE_PG_AUTH=password
# TWINVERSE_PG_REGION=us-west-2
# PGPASSWORD is ignored in IAM mode. Never paste a generated token here.
PGPASSWORD="REPLACE_WITH_DATABASE_PASSWORD"
PGSSLMODE=verify-full
PGSSLROOTCERT=./certs/rds-global-bundle.pem

# Optional public hosting behind Nginx (backend still binds to loopback).
# TWINVERSE_PUBLIC_ORIGIN=https://YOUR_PUBLIC_IP_OR_DOMAIN
# TWINVERSE_DB_PATH=/var/lib/twinverse/twinverse.sqlite3
# TWINVERSE_FACULTY_PASSWORD=YOUR_PRIVATE_PASSWORD
# TWINVERSE_DEVELOPER_PASSWORD=YOUR_PRIVATE_PASSWORD
# TWINVERSE_ENV_FILE=/absolute/path/to/private.env

# Optional live AI patient generation. Keep the real key in the private env only.
# Also run once: python3 -m pip install anthropic python-dotenv
# Short-term Bedrock keys last 12 hours; paste a new one and restart when it expires.
# For generation without AWS storage, set TWINVERSE_CLOUD_STORAGE=local above.
# AWS_BEARER_TOKEN_BEDROCK=YOUR_BEDROCK_API_KEY
# TWINVERSE_BEDROCK_REGION=us-west-2
